	measure 'Ticket Promedio (ID dataset)' =
			-- Valor global fijo: el id_transaccion del dataset sintetico no agrupa compras reales
			-- (ver docs/01_perfilamiento.md, seccion 5). No se segmenta.
			CALCULATE (
			    DIVIDE ( [Ventas Netas], [Transacciones (ID dataset)] ),
			    REMOVEFILTERS ()
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 9. Referencia guia (id_transaccion)
		lineageTag: 06ec1177-55f7-5782-99af-a51dab104eb8

	measure 'Ventas Ene-Sep Hace 2 Años' =
			IF (
			    HASONEVALUE ( DimCalendario[Año] ),
			    CALCULATE ( [Ventas Ene-Sep], DATEADD ( DimCalendario[Fecha], -2, YEAR ) )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 3. Tiempo (Ene-Sep)
		lineageTag: ed2d4a05-2fbe-5ecd-9b63-2312bc79cbe8

	measure 'Crecimiento vs Hace 2 Años %' =
			VAR Base = [Ventas Ene-Sep Hace 2 Años]
			RETURN
			    DIVIDE ( [Ventas Ene-Sep] - Base, Base )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Tiempo (Ene-Sep)
		lineageTag: 3eb4c369-28ce-57fb-86bd-7243221648bd

	measure 'Lectura Tendencia' =
			-- Tendencia = mismo signo y > ±2 % frente al año anterior Y frente a hace 2 años
			VAR A = [Crecimiento Ventas Ene-Sep %]
			VAR B = [Crecimiento vs Hace 2 Años %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( A ) || ISBLANK ( B ), BLANK (),
			        A > 0.02 && B > 0.02, "Crece (sostenido)",
			        A < -0.02 && B < -0.02, "Cae (sostenido)",
			        ABS ( A ) > 0.02, "Oscila (rebote)",
			        "Estable"
			    )
		displayFolder: 3. Tiempo (Ene-Sep)
		lineageTag: e0834d18-3f8a-5d07-915b-4255269e7a56

	measure 'Color Crecimiento' =
			-- Petróleo = crece sostenido, terracota = cae sostenido, ocre = oscila, gris = estable
			SWITCH (
			    [Lectura Tendencia],
			    "Crece (sostenido)", "#0E4D64",
			    "Cae (sostenido)", "#9A4A2C",
			    "Oscila (rebote)", "#A87B22",
			    "#7D858C"
			)
		displayFolder: 7. Formato condicional
		lineageTag: da674d36-4ba1-5366-b086-efe6d06943ce

	measure 'Crecimiento Año Anterior %' = CALCULATE ( [Crecimiento Ventas Ene-Sep %], DATEADD ( DimCalendario[Fecha], -1, YEAR ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Tiempo (Ene-Sep)
		lineageTag: f11ce9a4-33eb-5277-ae2c-30ac16fa5635

	measure 'SVG Podio' =
			VAR Anio = SELECTEDVALUE ( DimCalendario[Año] )
			VAR T =
			    ADDCOLUMNS (
			        ALL ( DimGeografia[Region] ),
			        "@g", [Crecimiento Ventas Ene-Sep %],
			        "@g2", [Crecimiento vs Hace 2 Años %],
			        "@gp", [Crecimiento Año Anterior %]
			    )
			VAR TV = FILTER ( T, NOT ISBLANK ( [@g] ) )
			VAR TP = FILTER ( TV, NOT ISBLANK ( [@gp] ) )
			VAR R =
			    ADDCOLUMNS (
			        TV,
			        "@r", RANKX ( TV, [@g], , DESC, SKIP ),
			        "@rp", IF ( NOT ISBLANK ( [@gp] ), RANKX ( TP, [@gp], , DESC, SKIP ) ),
			        "@c", SWITCH (
			            TRUE (),
			            [@g] > 0.02 && [@g2] > 0.02, "#0E4D64",
			            [@g] < -0.02 && [@g2] < -0.02, "#9A4A2C",
			            ABS ( [@g] ) > 0.02, "#A87B22",
			            "#7D858C"
			        )
			    )
			VAR F1 = FILTER ( R, [@r] = 1 )
			VAR N1 = MAXX ( F1, DimGeografia[Region] )
			VAR G1 = MAXX ( F1, [@g] )
			VAR H1 = MAXX ( F1, [@g2] )
			VAR P1 = IF ( ISBLANK ( N1 ), "", IF ( G1 > 0, "+", IF ( G1 < 0, "−", "" ) ) & SUBSTITUTE ( FORMAT ( ABS ( G1 ) * 100, "0.0" ), ".", "," ) & " %" )
			VAR S1 = IF ( ISBLANK ( N1 ), "", "vs " & ( Anio - 1 ) & IF ( ISBLANK ( H1 ), "", " · " & IF ( H1 > 0, "+", IF ( H1 < 0, "−", "" ) ) & SUBSTITUTE ( FORMAT ( ABS ( H1 ) * 100, "0.0" ), ".", "," ) & " %" & " vs " & ( Anio - 2 ) ) )
			VAR F2 = FILTER ( R, [@r] = 2 )
			VAR N2 = MAXX ( F2, DimGeografia[Region] )
			VAR G2 = MAXX ( F2, [@g] )
			VAR H2 = MAXX ( F2, [@g2] )
			VAR P2 = IF ( ISBLANK ( N2 ), "", IF ( G2 > 0, "+", IF ( G2 < 0, "−", "" ) ) & SUBSTITUTE ( FORMAT ( ABS ( G2 ) * 100, "0.0" ), ".", "," ) & " %" )
			VAR S2 = IF ( ISBLANK ( N2 ), "", "vs " & ( Anio - 1 ) & IF ( ISBLANK ( H2 ), "", " · " & IF ( H2 > 0, "+", IF ( H2 < 0, "−", "" ) ) & SUBSTITUTE ( FORMAT ( ABS ( H2 ) * 100, "0.0" ), ".", "," ) & " %" & " vs " & ( Anio - 2 ) ) )
			VAR F3 = FILTER ( R, [@r] = 3 )
			VAR N3 = MAXX ( F3, DimGeografia[Region] )
			VAR G3 = MAXX ( F3, [@g] )
			VAR H3 = MAXX ( F3, [@g2] )
			VAR P3 = IF ( ISBLANK ( N3 ), "", IF ( G3 > 0, "+", IF ( G3 < 0, "−", "" ) ) & SUBSTITUTE ( FORMAT ( ABS ( G3 ) * 100, "0.0" ), ".", "," ) & " %" )
			VAR S3 = IF ( ISBLANK ( N3 ), "", "vs " & ( Anio - 1 ) & IF ( ISBLANK ( H3 ), "", " · " & IF ( H3 > 0, "+", IF ( H3 < 0, "−", "" ) ) & SUBSTITUTE ( FORMAT ( ABS ( H3 ) * 100, "0.0" ), ".", "," ) & " %" & " vs " & ( Anio - 2 ) ) )
			VAR RP1_ = MAXX ( FILTER ( R, [@r] = 1 ), [@rp] )
			VAR NP_ = COUNTROWS ( TP )
			VAR TIT =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( RP1_ ), N1 & " lidera el crecimiento",
			        RP1_ = 1, N1 & " repite en el primer puesto",
			        RP1_ = NP_, N1 & " pasó del último puesto al primero",
			        N1 & " subió del puesto " & RP1_ & " al primero"
			    )
			VAR Msg = IF ( ISBLANK ( Anio ), "Seleccione un solo año", "Sin año anterior para comparar" )
			VAR Svg = IF ( ISBLANK ( N1 ), "<svg xmlns='http://www.w3.org/2000/svg' width='888' height='380'><text x='444' y='190' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='22' fill='#5B6770'>" & Msg & "</text></svg>", "<svg xmlns='http://www.w3.org/2000/svg' width='888' height='460' viewBox='0 0 888 460' font-family='Segoe UI, Arial, sans-serif'><text x='0' y='16' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>EL PODIO · CRECIMIENTO ENE–SEP FRENTE AL AÑO ANTERIOR</text><text x='0' y='52' font-family='Cambria, Georgia, serif' font-size='28' font-weight='700' fill='#1E2B2F'>" & ( TIT ) & "</text><rect x='33' y='450' width='250' height='0' rx='10' fill='#A9B1B9' fill-opacity='.16' stroke='#A9B1B9' stroke-width='2'><animate attributeName='height' from='0' to='119' dur='.8s' begin='0.25s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><animate attributeName='y' from='450' to='331' dur='.8s' begin='0.25s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/></rect><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='.5s' begin='0.85s' fill='freeze'/><text x='158' y='383' text-anchor='middle' font-size='44' font-weight='800' fill='#1E2B2F'>" & ( P2 ) & "</text><text x='158' y='411' text-anchor='middle' font-size='14' fill='#5B6770'>" & ( S2 ) & "</text></g><g opacity='0' transform='translate(0,-30)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.95s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 -30' to='0 0' dur='.5s' begin='0.95s' fill='freeze' calcMode='spline' keySplines='.3 1.4 .5 1'/><path d='M140 181h14l8 30h-14z' fill='#7A8A92'/><path d='M176 181h-14l-8 30h14z' fill='#52626A'/><circle cx='158' cy='243' r='36' fill='#A9B1B9'/><circle cx='158' cy='243' r='26' fill='none' stroke='rgba(255,255,255,.6)' stroke-width='2.5'/><text x='158' y='254' text-anchor='middle' font-size='32' font-weight='800' fill='#fff'>2</text><text x='158' y='309' text-anchor='middle' font-size='24' font-weight='700' fill='#1E2B2F'>" & ( N2 ) & "</text></g><rect x='319' y='450' width='250' height='0' rx='10' fill='#C9A227' fill-opacity='.16' stroke='#C9A227' stroke-width='2'><animate attributeName='height' from='0' to='170' dur='.8s' begin='0.5s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><animate attributeName='y' from='450' to='280' dur='.8s' begin='0.5s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/></rect><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='.5s' begin='1.1s' fill='freeze'/><text x='444' y='332' text-anchor='middle' font-size='44' font-weight='800' fill='#1E2B2F'>" & ( P1 ) & "</text><text x='444' y='360' text-anchor='middle' font-size='14' fill='#5B6770'>" & ( S1 ) & "</text></g><g opacity='0' transform='translate(0,-30)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='1.2s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 -30' to='0 0' dur='.5s' begin='1.2s' fill='freeze' calcMode='spline' keySplines='.3 1.4 .5 1'/><path d='M426 130h14l8 30h-14z' fill='#7A8A92'/><path d='M462 130h-14l-8 30h14z' fill='#52626A'/><circle cx='444' cy='192' r='36' fill='#C9A227'/><circle cx='444' cy='192' r='26' fill='none' stroke='rgba(255,255,255,.6)' stroke-width='2.5'/><text x='444' y='203' text-anchor='middle' font-size='32' font-weight='800' fill='#fff'>1</text><text x='444' y='258' text-anchor='middle' font-size='24' font-weight='700' fill='#1E2B2F'>" & ( N1 ) & "</text></g><rect x='605' y='450' width='250' height='0' rx='10' fill='#B9773F' fill-opacity='.16' stroke='#B9773F' stroke-width='2'><animate attributeName='height' from='0' to='88' dur='.8s' begin='0.0s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><animate attributeName='y' from='450' to='362' dur='.8s' begin='0.0s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/></rect><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='.5s' begin='0.6s' fill='freeze'/><text x='730' y='414' text-anchor='middle' font-size='44' font-weight='800' fill='#1E2B2F'>" & ( P3 ) & "</text><text x='730' y='442' text-anchor='middle' font-size='14' fill='#5B6770'>" & ( S3 ) & "</text></g><g opacity='0' transform='translate(0,-30)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.7s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 -30' to='0 0' dur='.5s' begin='0.7s' fill='freeze' calcMode='spline' keySplines='.3 1.4 .5 1'/><path d='M712 212h14l8 30h-14z' fill='#7A8A92'/><path d='M748 212h-14l-8 30h14z' fill='#52626A'/><circle cx='730' cy='274' r='36' fill='#B9773F'/><circle cx='730' cy='274' r='26' fill='none' stroke='rgba(255,255,255,.6)' stroke-width='2.5'/><text x='730' y='285' text-anchor='middle' font-size='32' font-weight='800' fill='#fff'>3</text><text x='730' y='340' text-anchor='middle' font-size='24' font-weight='700' fill='#1E2B2F'>" & ( N3 ) & "</text></g></svg>" )
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( Svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8. Diseño (SVG y textos)
		lineageTag: dc299613-5cd2-5f48-8d8b-bfae6ccde00d
		dataCategory: ImageUrl

	measure 'SVG Posiciones' =
			VAR Anio = SELECTEDVALUE ( DimCalendario[Año] )
			VAR T =
			    ADDCOLUMNS (
			        ALL ( DimGeografia[Region] ),
			        "@g", [Crecimiento Ventas Ene-Sep %],
			        "@g2", [Crecimiento vs Hace 2 Años %],
			        "@gp", [Crecimiento Año Anterior %]
			    )
			VAR TV = FILTER ( T, NOT ISBLANK ( [@g] ) )
			VAR TP = FILTER ( TV, NOT ISBLANK ( [@gp] ) )
			VAR R =
			    ADDCOLUMNS (
			        TV,
			        "@r", RANKX ( TV, [@g], , DESC, SKIP ),
			        "@rp", IF ( NOT ISBLANK ( [@gp] ), RANKX ( TP, [@gp], , DESC, SKIP ) ),
			        "@c", SWITCH (
			            TRUE (),
			            [@g] > 0.02 && [@g2] > 0.02, "#0E4D64",
			            [@g] < -0.02 && [@g2] < -0.02, "#9A4A2C",
			            ABS ( [@g] ) > 0.02, "#A87B22",
			            "#7D858C"
			        )
			    )
			VAR NR = COUNTROWS ( R )
			VAR MaxP = MAXX ( R, MAX ( [@g], 0 ) )
			VAR MaxN = MAXX ( R, MAX ( - [@g], 0 ) )
			VAR Esc = MIN ( IF ( MaxP > 0, 235.3 / MaxP, 1E9 ), IF ( MaxN > 0, 100.3 / MaxN, 1E9 ) )
			VAR Filas = CONCATENATEX ( R,
			            VAR Y = 36 + ( [@r] - 1 ) * 50
			            VAR WB = ROUND ( ABS ( [@g] ) * Esc, 1 )
			            VAR XB = IF ( [@g] >= 0, 483.8, 483.8 - WB )
			            RETURN "<line x1='0' x2='816' y1='" & ( Y + 50 ) & "' y2='" & ( Y + 50 ) & "' stroke='#E2DACB'/>" & ( IF ( [@r] <= 3, "<circle cx='22' cy='" & ( Y + 25.0 ) & "' r='17' fill='" & SWITCH ( [@r], 1, "#C9A227", 2, "#A9B1B9", "#B9773F" ) & "'/><text x='22' y='" & ( Y + 31.0 ) & "' text-anchor='middle' font-size='17' font-weight='800' fill='#fff'>" & [@r] & "</text>", "<text x='22' y='" & ( Y + 32.0 ) & "' text-anchor='middle' font-size='20' font-weight='700' fill='#5B6770'>" & [@r] & "</text>" ) ) & ( SWITCH ( TRUE (), ISBLANK ( [@rp] ), "", [@rp] > [@r], "<text x='96' y='" & ( Y + 31.0 ) & "' font-size='17' font-weight='700' fill='#0E4D64'>▲ " & ( [@rp] - [@r] ) & "</text>", [@rp] < [@r], "<text x='96' y='" & ( Y + 31.0 ) & "' font-size='17' font-weight='700' fill='#9A4A2C'>▼ " & ( [@r] - [@rp] ) & "</text>", "<text x='96' y='" & ( Y + 31.0 ) & "' font-size='17' fill='#5B6770'>=</text>" ) ) & "<text x='170' y='" & ( Y + 32.0 ) & "' font-size='20' font-weight='" & ( IF ( [@r] <= 3, 700, 500 ) ) & "' fill='#1E2B2F'>" & ( DimGeografia[Region] ) & "</text><rect x='483.8' y='" & ( Y + 15 ) & "' width='0' height='20' rx='4' fill='" & ( [@c] ) & "'><animate attributeName='width' from='0' to='" & ( FORMAT ( WB, "0.0", "en-US" ) ) & "' dur='.9s' begin='0." & ( [@r] - 1 ) & "s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><animate attributeName='x' from='483.8' to='" & ( FORMAT ( XB, "0.0", "en-US" ) ) & "' dur='.9s' begin='0." & ( [@r] - 1 ) & "s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/></rect><text x='810' y='" & ( Y + 32.0 ) & "' text-anchor='end' font-size='20' font-weight='700' fill='" & ( [@c] ) & "'>" & ( IF ( [@g] > 0, "+", IF ( [@g] < 0, "−", "" ) ) & SUBSTITUTE ( FORMAT ( ABS ( [@g] ) * 100, "0.0" ), ".", "," ) & " %" ) & "</text>",
			        "", [@r], ASC )
			VAR Msg = IF ( ISBLANK ( Anio ), "Seleccione un solo año", "Sin año anterior para comparar" )
			VAR M_ = ADDCOLUMNS ( FILTER ( R, NOT ISBLANK ( [@rp] ) ), "@m", [@rp] - [@r] )
			VAR MinM_ = MINX ( M_, [@m] )
			VAR Peores_ = FILTER ( M_, [@m] = MinM_ )
			VAR TIT =
			    SWITCH (
			        TRUE (),
			        ISEMPTY ( M_ ), "Sin tabla de " & ( Anio - 1 ) & " para comparar puestos",
			        MinM_ >= 0, "Ninguna región perdió puestos frente a " & ( Anio - 1 ),
			        CONCATENATEX ( Peores_, DimGeografia[Region], " y ", DimGeografia[Region], ASC )
			            & IF ( COUNTROWS ( Peores_ ) > 1, " bajaron ", " bajó " ) & ( - MinM_ )
			            & IF ( MinM_ = -1, " puesto", " puestos" )
			    )
			VAR Svg = IF ( NR = 0, "<svg xmlns='http://www.w3.org/2000/svg' width='888' height='380'><text x='444' y='190' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='22' fill='#5B6770'>" & Msg & "</text></svg>", "<svg xmlns='http://www.w3.org/2000/svg' width='816' height='474' viewBox='0 0 816 474' font-family='Segoe UI, Arial, sans-serif'><text x='0' y='16' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>TABLA DE POSICIONES · PUESTOS GANADOS O PERDIDOS</text><text x='0' y='52' font-family='Cambria, Georgia, serif' font-size='28' font-weight='700' fill='#1E2B2F'>" & ( TIT ) & "</text><g transform='translate(0,80)'><text x='0' y='18' font-size='12' letter-spacing='1.5' font-weight='700' fill='#5B6770'>PUESTO</text><text x='96' y='18' font-size='12' letter-spacing='1.5' font-weight='700' fill='#5B6770'>MOV.</text><text x='170' y='18' font-size='12' letter-spacing='1.5' font-weight='700' fill='#5B6770'>REGIÓN</text><text x='810' y='18' text-anchor='end' font-size='12' letter-spacing='1.5' font-weight='700' fill='#5B6770'>VS " & ( Anio - 1 ) & "</text><line x1='483.8' x2='483.8' y1='36' y2='" & ( 36 + NR * 50 ) & "' stroke='#5B6770' stroke-opacity='.5'/>" & Filas & "</g></svg>" )
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( Svg, "%", "%25" ), "#", "%23" )
