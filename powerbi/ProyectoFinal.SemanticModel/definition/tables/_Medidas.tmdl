	measure 'SVG KPIs' =
			VAR Anio = SELECTEDVALUE ( DimCalendario[Año] )
			VAR V = [Ventas Ene-Sep]
			VAR C = [Crecimiento Ventas Ene-Sep %]
			VAR Lect = [Lectura Tendencia]
			VAR A1 = CALCULATE ( [Ventas Ene-Sep], DimCalendario[Año] = Anio - 1 )
			VAR A2 = CALCULATE ( [Ventas Ene-Sep], DimCalendario[Año] = Anio - 2 )
			VAR K0 = IF ( ISBLANK ( V ), "—", "$" & SUBSTITUTE ( FORMAT ( V / 1E6, "0.0" ), ".", "," ) & " M" )
			VAR K1 = IF ( ISBLANK ( C ), "—", IF ( C > 0, "▲ ", IF ( C < 0, "▼ ", "" ) ) & SUBSTITUTE ( FORMAT ( ABS ( C ) * 100, "0.00" ), ".", "," ) & " %" )
			VAR K2 = SUBSTITUTE ( FORMAT ( [Margen Estimado %] * 100, "0.0" ), ".", "," ) & " %"
			VAR K3 = SUBSTITUTE ( FORMAT ( [% Quiebre] * 100, "0.0" ), ".", "," ) & " %"
			VAR K4 = "$" & SUBSTITUTE ( FORMAT ( [Venta por Linea], "#,0" ), ",", "." )
			VAR C0 = "#1E2B2F"
			VAR C1 = SWITCH ( Lect, "Crece (sostenido)", "#0E4D64", "Cae (sostenido)", "#9A4A2C", "#0E4D64" )
			VAR C2 = "#1E2B2F"
			VAR C3 = "#A87B22"
			VAR C4 = "#1E2B2F"
			VAR N0 = IF ( ISBLANK ( Anio ), "Seleccione un solo año", IF ( ISBLANK ( A1 ), "Primer año de la serie", ( Anio - 1 ) & ": " & "$" & SUBSTITUTE ( FORMAT ( A1 / 1E6, "0.0" ), ".", "," ) & " M" & IF ( ISBLANK ( A2 ), "", " · " & ( Anio - 2 ) & ": " & "$" & SUBSTITUTE ( FORMAT ( A2 / 1E6, "0.0" ), ".", "," ) & " M" ) ) )
			VAR N1 = SWITCH ( TRUE (), ISBLANK ( C ), "Sin año anterior", ABS ( C ) < 0.02, "Plano: no es tendencia", Lect = "Crece (sostenido)", "Crece frente a dos años", Lect = "Cae (sostenido)", "Cae frente a dos años", "Rebote: no es tendencia" )
			VAR N2 = "Igual en todos los grupos"
			VAR N3 = "Parejo en toda la cadena"
			VAR N4 = "Ticket ref. ID: $" & SUBSTITUTE ( FORMAT ( [Ticket Promedio (ID dataset)], "#,0" ), ",", "." ) & " ⓘ"
			VAR Svg = "<svg xmlns='http://www.w3.org/2000/svg' width='1800' height='112' viewBox='0 0 1800 112' font-family='Segoe UI, Arial, sans-serif'><text x='0' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>VENTAS ENE–SEP</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.00s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.00s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='0' y='68' font-family='Consolas, Courier New, monospace' font-size='46' font-weight='700' fill='" & ( C0 ) & "'>" & ( K0 ) & "</text></g><text x='0' y='100' font-size='14' fill='#5B6770'>" & ( N0 ) & "</text><line x1='348' x2='348' y1='0' y2='112' stroke='#E2DACB'/><text x='364' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>FRENTE A " & ( Anio - 1 ) & "</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.12s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.12s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='364' y='68' font-family='Consolas, Courier New, monospace' font-size='46' font-weight='700' fill='" & ( C1 ) & "'>" & ( K1 ) & "</text></g><text x='364' y='100' font-size='14' fill='#5B6770'>" & ( N1 ) & "</text><line x1='712' x2='712' y1='0' y2='112' stroke='#E2DACB'/><text x='728' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>MARGEN ESTIMADO</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.24s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.24s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='728' y='68' font-family='Consolas, Courier New, monospace' font-size='46' font-weight='700' fill='" & ( C2 ) & "'>" & ( K2 ) & "</text></g><text x='728' y='100' font-size='14' fill='#5B6770'>" & ( N2 ) & "</text><line x1='1076' x2='1076' y1='0' y2='112' stroke='#E2DACB'/><text x='1092' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>LÍNEAS CON QUIEBRE</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.36s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.36s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='1092' y='68' font-family='Consolas, Courier New, monospace' font-size='46' font-weight='700' fill='" & ( C3 ) & "'>" & ( K3 ) & "</text></g><text x='1092' y='100' font-size='14' fill='#5B6770'>" & ( N3 ) & "</text><line x1='1440' x2='1440' y1='0' y2='112' stroke='#E2DACB'/><text x='1456' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>VENTA POR LÍNEA</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.48s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.48s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='1456' y='68' font-family='Consolas, Courier New, monospace' font-size='46' font-weight='700' fill='" & ( C4 ) & "'>" & ( K4 ) & "</text></g><text x='1456' y='100' font-size='14' fill='#5B6770'>" & ( N4 ) & "</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( Svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8. Diseño (SVG y textos)
		lineageTag: 24b83bd9-3137-545c-9ccb-a82e507bfc17
		dataCategory: ImageUrl

	measure 'SVG Titulo Resumen' =
			VAR C = [Crecimiento Ventas Ene-Sep %]
			VAR P = IF ( C > 0, "+", IF ( C < 0, "−", "" ) ) & SUBSTITUTE ( FORMAT ( ABS ( C ) * 100, "0.0" ), ".", "," ) & " %"
			VAR T1 = SWITCH ( TRUE (), ISBLANK ( C ), "Seleccione un año con año anterior", ABS ( C ) < 0.02, "El negocio está plano (", C > 0, "El negocio crece (", "El negocio cae (" )
			VAR T2 = IF ( ISBLANK ( C ), "", P )
			VAR T3 = IF ( ISBLANK ( C ), "", "), pero las regiones se mueven" )
			VAR Svg = "<svg xmlns='http://www.w3.org/2000/svg' width='1110' height='60' viewBox='0 0 1110 60' font-family='Cambria, Georgia, serif'><text x='0' y='42' font-size='38' font-weight='700' fill='#1E2B2F'>" & ( T1 ) & "<tspan fill='#0E4D64'>" & ( T2 ) & "</tspan>" & ( T3 ) & "</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( Svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8. Diseño (SVG y textos)
		lineageTag: 0043af26-2c80-505a-bb0b-77a06e525529
		dataCategory: ImageUrl

	measure 'SVG KPIs Promociones' =
			VAR K0 = SUBSTITUTE ( FORMAT ( [% Ventas en Promocion] * 100, "0.0" ), ".", "," ) & " %"
			VAR K1 = SUBSTITUTE ( FORMAT ( [Margen Estimado %] * 100, "0.0" ), ".", "," ) & " %"
			VAR K2 = SUBSTITUTE ( FORMAT ( [Unidades por Linea], "0.00" ), ".", "," )
			VAR N0 = "$" & SUBSTITUTE ( FORMAT ( [Ventas en Promocion] / 1E6, "0.0" ), ".", "," ) & " M" & " de " & "$" & SUBSTITUTE ( FORMAT ( [Ventas Netas] / 1E6, "0.0" ), ".", "," ) & " M"
			VAR N1 = "Igual en todos los grupos"
			VAR N2 = "Promedio por línea de venta"
			VAR Svg = "<svg xmlns='http://www.w3.org/2000/svg' width='870' height='112' viewBox='0 0 870 112' font-family='Segoe UI, Arial, sans-serif'><text x='0' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>VENTAS CON PROMOCIÓN</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.00s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.00s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='0' y='68' font-family='Consolas, Courier New, monospace' font-size='44' font-weight='700' fill='#1E2B2F'>" & ( K0 ) & "</text></g><text x='0' y='100' font-size='14' fill='#5B6770'>" & ( N0 ) & "</text><line x1='274' x2='274' y1='0' y2='112' stroke='#E2DACB'/><text x='290' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>MARGEN ESTIMADO</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.12s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.12s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='290' y='68' font-family='Consolas, Courier New, monospace' font-size='44' font-weight='700' fill='#1E2B2F'>" & ( K1 ) & "</text></g><text x='290' y='100' font-size='14' fill='#5B6770'>" & ( N1 ) & "</text><line x1='564' x2='564' y1='0' y2='112' stroke='#E2DACB'/><text x='580' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>UNIDADES POR LÍNEA</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.24s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.24s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='580' y='68' font-family='Consolas, Courier New, monospace' font-size='44' font-weight='700' fill='#1E2B2F'>" & ( K2 ) & "</text></g><text x='580' y='100' font-size='14' fill='#5B6770'>" & ( N2 ) & "</text></svg>"
			RETURN
