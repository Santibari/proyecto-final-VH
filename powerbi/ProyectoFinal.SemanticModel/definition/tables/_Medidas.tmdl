	measure 'SVG Tiquete' =
			VAR Ult = YEAR ( CALCULATE ( MAX ( FactVentas[fecha] ), REMOVEFILTERS () ) )
			VAR A0 = Ult - 2
			VAR V0 = CALCULATE ( [Ventas Ene-Sep], REMOVEFILTERS ( DimCalendario ), DimCalendario[Año] = A0 )
			VAR T0 = "$" & SUBSTITUTE ( FORMAT ( V0, "#,0" ), ",", "." )
			VAR A1 = Ult - 1
			VAR V1 = CALCULATE ( [Ventas Ene-Sep], REMOVEFILTERS ( DimCalendario ), DimCalendario[Año] = A1 )
			VAR T1 = "$" & SUBSTITUTE ( FORMAT ( V1, "#,0" ), ",", "." )
			VAR A2 = Ult - 0
			VAR V2 = CALCULATE ( [Ventas Ene-Sep], REMOVEFILTERS ( DimCalendario ), DimCalendario[Año] = A2 )
			VAR T2 = "$" & SUBSTITUTE ( FORMAT ( V2, "#,0" ), ",", "." )
			VAR Crec = DIVIDE ( V2 - V1, V1 )
			VAR VX = IF ( Crec > 0, "+", IF ( Crec < 0, "−", "" ) ) & SUBSTITUTE ( FORMAT ( ABS ( Crec ) * 100, "0.00" ), ".", "," ) & " %"
			VAR Svg = "<svg xmlns='http://www.w3.org/2000/svg' width='568' height='760' viewBox='0 0 568 760' font-family='Consolas, Courier New, monospace'><text x='284.0' y='26' text-anchor='middle' font-size='25' font-weight='700' letter-spacing='2' fill='#1E2B2F'>CADENA NACIONAL</text><text x='284.0' y='56' text-anchor='middle' font-size='18' fill='#1E2B2F'>DE SUPERMERCADOS</text><text x='284.0' y='84' text-anchor='middle' font-size='18' fill='#5B6770'>TIQUETE DE VENTAS · ENE–SEP</text><line x1='0' x2='568' y1='124' y2='124' stroke='#E2DACB' stroke-width='2' stroke-dasharray='8 6'/><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='.25s' begin='0.15s' fill='freeze'/><text x='0' y='170' font-size='22' fill='#1E2B2F' font-weight='400'>ENE–SEP " & ( A0 ) & "</text><text x='568' y='170' text-anchor='end' font-size='22' fill='#1E2B2F' font-weight='400'>" & ( T0 ) & "</text></g><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='.25s' begin='0.40s' fill='freeze'/><text x='0' y='212' font-size='22' fill='#1E2B2F' font-weight='400'>ENE–SEP " & ( A1 ) & "</text><text x='568' y='212' text-anchor='end' font-size='22' fill='#1E2B2F' font-weight='400'>" & ( T1 ) & "</text></g><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='.25s' begin='0.65s' fill='freeze'/><text x='0' y='254' font-size='22' fill='#1E2B2F' font-weight='700'>ENE–SEP " & ( A2 ) & "</text><text x='568' y='254' text-anchor='end' font-size='22' fill='#1E2B2F' font-weight='700'>" & ( T2 ) & "</text></g><line x1='0' x2='568' y1='290' y2='290' stroke='#E2DACB' stroke-width='2' stroke-dasharray='8 6'/><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='.3s' begin='1s' fill='freeze'/><text x='0' y='352' font-size='22' font-weight='700' fill='#1E2B2F'>VARIACIÓN</text><text x='568' y='362' text-anchor='end' font-size='66' font-weight='700' fill='#0E4D64'>" & ( VX ) & "</text></g><text x='0' y='410' font-size='15' fill='#5B6770'>* PLANO EN EL TOTAL. POR DENTRO, NO.</text><line x1='0' x2='568' y1='446' y2='446' stroke='#E2DACB' stroke-width='2' stroke-dasharray='8 6'/><text x='0' y='500' font-size='20' font-weight='700' fill='#0E4D64'>01</text><text x='40' y='500' font-size='20' fill='#1E2B2F'>RESUMEN EJECUTIVO</text><line x1='239' x2='538' y1='495' y2='495' stroke='#5B6770' stroke-width='2' stroke-dasharray='1 5' stroke-linecap='round'/><text x='568' y='500' text-anchor='end' font-size='20' fill='#1E2B2F'>→</text><text x='0' y='546' font-size='20' font-weight='700' fill='#0E4D64'>02</text><text x='40' y='546' font-size='20' fill='#1E2B2F'>DESEMPEÑO COMERCIAL</text><line x1='261' x2='538' y1='541' y2='541' stroke='#5B6770' stroke-width='2' stroke-dasharray='1 5' stroke-linecap='round'/><text x='568' y='546' text-anchor='end' font-size='20' fill='#1E2B2F'>→</text><text x='0' y='592' font-size='20' font-weight='700' fill='#0E4D64'>03</text><text x='40' y='592' font-size='20' fill='#1E2B2F'>PROMOCIONES Y CANALES</text><line x1='283' x2='538' y1='587' y2='587' stroke='#5B6770' stroke-width='2' stroke-dasharray='1 5' stroke-linecap='round'/><text x='568' y='592' text-anchor='end' font-size='20' fill='#1E2B2F'>→</text><text x='0' y='638' font-size='20' font-weight='700' fill='#0E4D64'>04</text><text x='40' y='638' font-size='20' fill='#1E2B2F'>DISPONIBILIDAD</text><line x1='206' x2='538' y1='633' y2='633' stroke='#5B6770' stroke-width='2' stroke-dasharray='1 5' stroke-linecap='round'/><text x='568' y='638' text-anchor='end' font-size='20' fill='#1E2B2F'>→</text><text x='0' y='684' font-size='20' font-weight='700' fill='#0E4D64'>05</text><text x='40' y='684' font-size='20' fill='#1E2B2F'>CONCLUSIONES</text><line x1='184' x2='538' y1='679' y2='679' stroke='#5B6770' stroke-width='2' stroke-dasharray='1 5' stroke-linecap='round'/><text x='568' y='684' text-anchor='end' font-size='20' fill='#1E2B2F'>→</text><rect x='184' y='700' width='3' height='54' fill='#1E2B2F'/><rect x='189' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='194' y='700' width='4' height='54' fill='#1E2B2F'/><rect x='201' y='700' width='2' height='54' fill='#1E2B2F'/><rect x='206' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='210' y='700' width='3' height='54' fill='#1E2B2F'/><rect x='215' y='700' width='2' height='54' fill='#1E2B2F'/><rect x='221' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='225' y='700' width='4' height='54' fill='#1E2B2F'/><rect x='232' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='237' y='700' width='3' height='54' fill='#1E2B2F'/><rect x='243' y='700' width='2' height='54' fill='#1E2B2F'/><rect x='247' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='251' y='700' width='4' height='54' fill='#1E2B2F'/><rect x='259' y='700' width='2' height='54' fill='#1E2B2F'/><rect x='264' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='268' y='700' width='3' height='54' fill='#1E2B2F'/><rect x='273' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='278' y='700' width='2' height='54' fill='#1E2B2F'/><rect x='283' y='700' width='4' height='54' fill='#1E2B2F'/><rect x='289' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='294' y='700' width='3' height='54' fill='#1E2B2F'/><rect x='300' y='700' width='2' height='54' fill='#1E2B2F'/><rect x='305' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='310' y='700' width='3' height='54' fill='#1E2B2F'/><rect x='316' y='700' width='2' height='54' fill='#1E2B2F'/><rect x='320' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='325' y='700' width='4' height='54' fill='#1E2B2F'/><rect x='331' y='700' width='2' height='54' fill='#1E2B2F'/><rect x='336' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='340' y='700' width='3' height='54' fill='#1E2B2F'/><rect x='347' y='700' width='2' height='54' fill='#1E2B2F'/><rect x='352' y='700' width='3' height='54' fill='#1E2B2F'/><rect x='357' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='362' y='700' width='4' height='54' fill='#1E2B2F'/><rect x='369' y='700' width='2' height='54' fill='#1E2B2F'/><rect x='374' y='700' width='1' height='54' fill='#1E2B2F'/><rect x='378' y='700' width='3' height='54' fill='#1E2B2F'/><rect x='383' y='700' width='2' height='54' fill='#1E2B2F'/></svg>"
