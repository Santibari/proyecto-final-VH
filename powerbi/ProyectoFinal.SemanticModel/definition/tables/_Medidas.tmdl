	measure 'SVG KPIs Disponibilidad' =
			VAR K0 = SUBSTITUTE ( FORMAT ( [% Quiebre] * 100, "0.0" ), ".", "," ) & " %"
			VAR K1 = SUBSTITUTE ( FORMAT ( [Lineas con Quiebre], "#,0" ), ",", "." )
			VAR K2 = "$" & SUBSTITUTE ( FORMAT ( [Ventas con Quiebre] / 1E6, "0.0" ), ".", "," ) & " M"
			VAR N0 = "Estable: cerca de 8 % en 2024–2026"
			VAR N1 = "de " & SUBSTITUTE ( FORMAT ( [Lineas de Venta], "#,0" ), ",", "." ) & " líneas de venta"
			VAR N2 = "Registradas en quiebre; no son pérdidas"
			VAR Svg = "<svg xmlns='http://www.w3.org/2000/svg' width='870' height='112' viewBox='0 0 870 112' font-family='Segoe UI, Arial, sans-serif'><text x='0' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>LÍNEAS CON QUIEBRE</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.00s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.00s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='0' y='68' font-family='Consolas, Courier New, monospace' font-size='44' font-weight='700' fill='#A87B22'>" & ( K0 ) & "</text></g><text x='0' y='100' font-size='14' fill='#5B6770'>" & ( N0 ) & "</text><line x1='274' x2='274' y1='0' y2='112' stroke='#E2DACB'/><text x='290' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>LÍNEAS AFECTADAS</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.12s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.12s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='290' y='68' font-family='Consolas, Courier New, monospace' font-size='44' font-weight='700' fill='#1E2B2F'>" & ( K1 ) & "</text></g><text x='290' y='100' font-size='14' fill='#5B6770'>" & ( N1 ) & "</text><line x1='564' x2='564' y1='0' y2='112' stroke='#E2DACB'/><text x='580' y='14' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>VENTAS CON QUIEBRE</text><g opacity='0' transform='translate(0,12)'><animate attributeName='opacity' from='0' to='1' dur='.4s' begin='0.24s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 12' to='0 0' dur='.5s' begin='0.24s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/><text x='580' y='68' font-family='Consolas, Courier New, monospace' font-size='44' font-weight='700' fill='#1E2B2F'>" & ( K2 ) & "</text></g><text x='580' y='100' font-size='14' fill='#5B6770'>" & ( N2 ) & "</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( Svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8. Diseño (SVG y textos)
		lineageTag: 6b5198d7-8b60-5885-9899-88aa7940c1bd
		dataCategory: ImageUrl

	measure 'SVG Fidelizacion' =
			VAR VLS = CALCULATE ( [Venta por Linea], DimCondicionVenta[Cliente fidelizado] = "Sí" )
			VAR VLN = CALCULATE ( [Venta por Linea], DimCondicionVenta[Cliente fidelizado] = "No" )
			VAR MGS = CALCULATE ( [Margen Estimado %], DimCondicionVenta[Cliente fidelizado] = "Sí" )
			VAR MGN = CALCULATE ( [Margen Estimado %], DimCondicionVenta[Cliente fidelizado] = "No" )
			VAR PS = DIVIDE ( CALCULATE ( [Ventas Ene-Sep], DimCondicionVenta[Cliente fidelizado] = "Sí" ), [Ventas Ene-Sep] )
			VAR Dif = DIVIDE ( VLS - VLN, VLN )
			VAR Igual = ABS ( Dif ) < 0.02 && ABS ( MGS - MGN ) < 0.01
			VAR TIT = IF ( Igual, "Misma venta por línea y mismo margen", "La venta por línea difiere " & SUBSTITUTE ( FORMAT ( ABS ( Dif ) * 100, "0.0" ), ".", "," ) & " %" )
			VAR SIG = IF ( Igual, "=", "≠" )
			VAR VS = "$" & SUBSTITUTE ( FORMAT ( VLS, "#,0" ), ",", "." )
			VAR VN = "$" & SUBSTITUTE ( FORMAT ( VLN, "#,0" ), ",", "." )
			VAR MS = SUBSTITUTE ( FORMAT ( MGS * 100, "0.0" ), ".", "," ) & " %"
			VAR MN = SUBSTITUTE ( FORMAT ( MGN * 100, "0.0" ), ".", "," ) & " %"
			VAR PST = SUBSTITUTE ( FORMAT ( PS * 100, "0" ), ".", "," ) & " %"
			VAR PNT = SUBSTITUTE ( FORMAT ( ( 1 - PS ) * 100, "0" ), ".", "," ) & " % no fidelizados"
			VAR Svg = "<svg xmlns='http://www.w3.org/2000/svg' width='594' height='362' viewBox='0 0 594 362' font-family='Segoe UI, Arial, sans-serif'><text x='0' y='16' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>FIDELIZADOS VS NO FIDELIZADOS</text><text x='0' y='50' font-family='Cambria, Georgia, serif' font-size='24' font-weight='700' fill='#1E2B2F'>" & ( TIT ) & "</text><text x='148' y='100' text-anchor='middle' font-size='13' letter-spacing='2' font-weight='700' fill='#0E4D64'>FIDELIZADOS</text><text x='446' y='100' text-anchor='middle' font-size='13' letter-spacing='2' font-weight='700' fill='#5B6770'>NO FIDELIZADOS</text><text x='297' y='178' text-anchor='middle' font-size='64' font-weight='300' fill='#7D858C'>" & ( SIG ) & "</text><text x='148' y='160' text-anchor='middle' font-family='Consolas, Courier New, monospace' font-size='40' font-weight='700' fill='#1E2B2F'>" & ( VS ) & "</text><text x='446' y='160' text-anchor='middle' font-family='Consolas, Courier New, monospace' font-size='40' font-weight='700' fill='#1E2B2F'>" & ( VN ) & "</text><text x='148' y='182' text-anchor='middle' font-size='13' fill='#5B6770'>venta por línea</text><text x='446' y='182' text-anchor='middle' font-size='13' fill='#5B6770'>venta por línea</text><text x='148' y='236' text-anchor='middle' font-family='Consolas, Courier New, monospace' font-size='28' font-weight='700' fill='#1E2B2F'>" & ( MS ) & "</text><text x='446' y='236' text-anchor='middle' font-family='Consolas, Courier New, monospace' font-size='28' font-weight='700' fill='#1E2B2F'>" & ( MN ) & "</text><text x='148' y='256' text-anchor='middle' font-size='13' fill='#5B6770'>margen estimado</text><text x='446' y='256' text-anchor='middle' font-size='13' fill='#5B6770'>margen estimado</text><rect x='0' y='296' width='594' height='18' rx='3' fill='#C9C2B3'/><rect x='0' y='296' width='0' height='18' rx='3' fill='#0E4D64'><animate attributeName='width' from='0' to='" & ( FORMAT ( PS * 594, "0.0", "en-US" ) ) & "' dur='.9s' fill='freeze' calcMode='spline' keySplines='.2 .8 .2 1'/></rect><text x='0' y='338' font-size='14' fill='#1E2B2F'><tspan font-weight='700'>" & ( PST ) & "</tspan> de las ventas ene–sep</text><text x='594' y='338' text-anchor='end' font-size='14' fill='#5B6770'><tspan font-weight='700'>" & ( PNT ) & "</tspan></text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( Svg, "%", "%25" ), "#", "%23" )
		displayFolder: 8. Diseño (SVG y textos)
		lineageTag: e761f27e-e0ac-5846-aea5-6d882c3e4b7f
		dataCategory: ImageUrl

	column Medidas
		dataType: string
		isHidden
		lineageTag: 70843f8a-cb79-512e-898d-aababd57aa08
		summarizeBy: none
		sourceColumn: Medidas

	partition _Medidas = m
		mode: import
		source =
				let
				    Fuente = #table(type table [Medidas = text], {})
				in
				    Fuente

	annotation PBI_ResultType = Table

