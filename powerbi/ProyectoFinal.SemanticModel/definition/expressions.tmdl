expression RutaCSV = "C:\Users\USUARIO\Documents\Sabana universidad\Sabana 7 semestre\Herramientas de dataviz BI\proyecto-final-VH\data\raw\03_cadena_supermercados.csv" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = false]
